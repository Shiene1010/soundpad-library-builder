# Copy this file to .env for local development.
# Never commit .env or real API keys.

# Google OAuth / Firebase Auth
GOOGLE_CLIENT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=

# Operator-owned Gemini API key
GEMINI_API_KEY=

# GitHub publishing target
GITHUB_OWNER=
GITHUB_REPO=soundpad-library-builder
GITHUB_BRANCH=main

# Optional GitHub token for local publishing only.
# Prefer short-lived or fine-grained tokens with contents:write scope.
GITHUB_TOKEN=
GITHUB_REPOSITORY_ID=
GITHUB_DISCUSSION_CATEGORY_ID=

# Cloudflare deployment, if used later
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PROJECT_NAME=soundpad-library-builder

# Product analytics and error reporting, if used later
GA_MEASUREMENT_ID=
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
